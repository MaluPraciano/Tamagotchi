package service;

import model.Pet;
import repository.PetRepository;
import exceptions.PetEstaComEnergiaBaixaException;
import exceptions.PetNaoEncontradoException;

public class PetService {
	private PetRepository petRepository;
	
	public PetService(PetRepository petRepository) {
		this.petRepository = petRepository;
	}
	
	private Pet buscarPet() throws PetNaoEncontradoException {
	    Pet pet = petRepository.find();
	    if (pet == null) {
	        throw new PetNaoEncontradoException("Crie um pet primeiro!");
	    }
	    return pet;
	}
	public void alimentar() throws PetSemFomeException {
		Pet pet = petRepository.find();
		if (pet.getSaciado() > 90) {
			throw new PetSemFomeException("Pet já está saciado!");
		}
		pet.alimentar();
		pet.passarTurno();
	}
	
	public void brincar() throws PetEstaComEnergiaBaixaException {
		Pet pet = petRepository.find();
		if (pet.getEnergia() < 30) {
			throw new PetEstaComEnergiaBaixaException("Seu pet está sem energia para brincar");
		}
		pet.brincar();
		pet.passarTurno();
	}
	
	public void dormir() throws Pet
}
